# ---- MongoDB (shared saved channels + download history) ----
# Same cluster as automation-server. Unset -> local JSON files.
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=youtube_automation

# ---- Hosted deployment (all optional; unset = local desktop behaviour) ----
# Hosted mode: hide local-only controls (folder picker, Reveal in Finder).
REEL_HOSTED=1
# Require a login (HTTP Basic; any username, this password). Strongly recommended when public.
REEL_PASSWORD=change-me
# Force the server-side download folder (mount a persistent disk here).
REEL_DOWNLOAD_DIR=/data/downloads
# Get past YouTube's datacenter-IP bot checks — point at a cookies.txt you upload.
REEL_COOKIES_FILE=/data/cookies.txt
# ...or pull cookies from a local browser instead (local use only):
# REEL_COOKIES_FROM_BROWSER=chrome
